# Copie para .env e preencha. O .env está no .gitignore.
WEEDIARIO_DB_USER=weediario
WEEDIARIO_DB_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 48
WEEDIARIO_JWT_SECRET=
# Chave dos pseudônimos de reações/denúncias. Gere com: openssl rand -base64 48 (diferente da do JWT)
WEEDIARIO_PSEUDONYM_KEY=
WEEDIARIO_CORS_ORIGINS=http://localhost:4200
