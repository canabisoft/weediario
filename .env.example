# Não edite à mão: gere o .env com scripts/setup-env.sh (ou scripts\setup-env.ps1).
# O .env está no .gitignore.
# Superusuário do Postgres: só manutenção e backup (o backend não usa).
WEEDIARIO_DB_USER=weediario
WEEDIARIO_DB_PASSWORD=
# Papéis criados pelo serviço db-roles: dono do schema (migrations) e o da aplicação (só lê e escreve linhas).
WEEDIARIO_DB_OWNER_PASSWORD=
WEEDIARIO_DB_APP_PASSWORD=
# Base64, mínimo 256 bits: openssl rand -base64 48
WEEDIARIO_JWT_SECRET=
# Chave dos pseudônimos de reações/denúncias, diferente da do JWT: openssl rand -base64 48
WEEDIARIO_PSEUDONYM_KEY=
# Cifra AES-256 dos textos de saúde (tratamento). Exatamente 32 bytes: openssl rand -base64 32
# Guarde uma cópia segura: sem ela os textos de saúde já gravados ficam ilegíveis.
WEEDIARIO_HEALTH_KEY=
# Cifra AES-256 dos e-mails (opcionais) das contas. Exatamente 32 bytes: openssl rand -base64 32
# Guarde uma cópia segura: sem ela os e-mails já cadastrados ficam ilegíveis.
WEEDIARIO_EMAIL_KEY=
# Porta local onde o app fica disponível (http://localhost:8080)
WEEDIARIO_HTTP_PORT=8080
# Só para o perfil "https" (Caddy + Let's Encrypt): domínio público apontando para este servidor
# WEEDIARIO_DOMAIN=weediario.exemplo.com
# E-mail das contas (opcional): confirmação do endereço, redefinição de senha e avisos de segurança.
# Sem SMTP o app funciona, mas esses e-mails não saem (a recuperação pela frase de 12 palavras continua valendo).
# WEEDIARIO_PUBLIC_URL=https://weediario.exemplo.com
# WEEDIARIO_MAIL_FROM=nao-responda@weediario.exemplo.com
# SPRING_MAIL_HOST=smtp.exemplo.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Porta 465 (SSL direto, ex. Hostinger): SSL_ENABLE=true e STARTTLS_ENABLE=false
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
# Dia em que os Termos de Uso entraram no ar (lançamento em produção), formato AAAA-MM-DD
# WEEDIARIO_TERMS_PUBLISHED_ON=2026-11-01
# Troca da chave dos dados de saúde: a(s) antiga(s), separadas por vírgula, só durante a troca
# WEEDIARIO_HEALTH_PREVIOUS_KEYS=
# Backup cifrado (scripts/backup.sh): chave PÚBLICA do age. Gere o par no SEU computador (age-keygen -o
# weediario-backup.key) e cole aqui só a linha "public key"; a chave privada nunca vai para o servidor.
# WEEDIARIO_BACKUP_RECIPIENT=age1...
# Cópia dos backups fora do servidor (opcional), um remoto do rclone: de preferência bucket com retenção/object lock
# WEEDIARIO_BACKUP_RCLONE=b2:weediario-backups
