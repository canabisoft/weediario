# Não edite à mão: gere o .env com scripts/setup-env.sh (ou scripts\setup-env.ps1).
# O .env está no .gitignore.
WEEDIARIO_DB_USER=weediario
WEEDIARIO_DB_PASSWORD=
# Base64, mínimo 256 bits: openssl rand -base64 48
WEEDIARIO_JWT_SECRET=
# Chave dos pseudônimos de reações/denúncias, diferente da do JWT: openssl rand -base64 48
WEEDIARIO_PSEUDONYM_KEY=
# Porta local onde o app fica disponível (http://localhost:8080)
WEEDIARIO_HTTP_PORT=8080
# Só para o perfil "https" (Caddy + Let's Encrypt): domínio público apontando para este servidor
# WEEDIARIO_DOMAIN=weediario.exemplo.com
