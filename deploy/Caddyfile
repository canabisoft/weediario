# HTTPS na frente do nginx (perfil "https" do compose).
# - Domínio real: certificado Let's Encrypt automático (portas 80 e 443 abertas para a internet).
# - "localhost": certificado de uma CA local do Caddy, para testar HTTPS na máquina.
#
# Privacidade: sem log de acesso e sem repassar o IP do visitante adiante. A única exceção é X-Weediario-Client,
# que o nginx usa só em memória para limitar tentativas de login por IP e não repassa ao backend.
{
	log {
		level ERROR
	}
}

{$WEEDIARIO_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:8080 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up X-Forwarded-Proto https
		header_up X-Weediario-Client {remote_host}
	}
}

# Outros nomes do site (www, outro TLD): certificado próprio e redirecionamento permanente para o domínio principal.
# Lista separada por vírgula em WEEDIARIO_REDIRECT_DOMAINS, ex. "www.weediario.com, weediario.com.br".
{$WEEDIARIO_REDIRECT_DOMAINS:www.localhost} {
	redir https://{$WEEDIARIO_DOMAIN:localhost}{uri} permanent
}
