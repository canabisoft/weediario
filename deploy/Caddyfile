# HTTPS na frente do nginx (perfil "https" do compose).
# - Domínio real: certificado Let's Encrypt automático (portas 80 e 443 abertas para a internet).
# - "localhost": certificado de uma CA local do Caddy, para testar HTTPS na máquina.
#
# Privacidade: sem log de acesso e sem repassar o IP do visitante adiante.
{
	log {
		level ERROR
	}
}

{$WEEDIARIO_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy frontend:8080 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		header_up X-Forwarded-Proto https
	}
}
